APP_NAME=SocialHub
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
APP_TIMEZONE=Europe/Istanbul

APP_LOCALE=tr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=tr_TR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- SocialHub ---
# Gerçek API anahtarları bağlanana kadar demo modu açık kalır (demo veriler DEMO etiketiyle gösterilir).
SOCIALHUB_DEMO_MODE=true
# Giriş ekranında demo hesap bilgilerini göster (yalnızca yerel kullanım).
SOCIALHUB_SHOW_DEMO_CREDENTIALS=true

INERTIA_SSR_ENABLED=false

# FFmpeg (ücretsiz, isteğe bağlı): video süresi/çözünürlüğü ve kapak üretimi için.
# PATH'te yoksa tam yol verin, örn: C:\ffmpeg\bin\ffmpeg.exe
FFMPEG_PATH=
FFPROBE_PATH=

# Medya boyut sınırları (MB)
SOCIALHUB_MAX_VIDEO_MB=2048
SOCIALHUB_MAX_IMAGE_MB=20

# Platform anahtarları panelde Ayarlar sayfasından girilir ve şifreli saklanır.
# İsterseniz buradan da verebilirsiniz (panel ayarı önceliklidir):
# SOCIALHUB_YOUTUBE_API_KEY=
# SOCIALHUB_YOUTUBE_CLIENT_ID=
# SOCIALHUB_YOUTUBE_CLIENT_SECRET=

# Uzun video yüklemeleri için kuyruk işi zaman aşımı (sn). Yayın işi 1 saate kadar sürebilir.
DB_QUEUE_RETRY_AFTER=3800
